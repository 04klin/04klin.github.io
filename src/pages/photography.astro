---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";

import grandfatherMntPeak from "../assets/photography/grandfather_mnt_peak.jpg";
import hills from "../assets/photography/hills.jpg";
import marketplace from "../assets/photography/marketplace.jpg";
import alleyway from "../assets/photography/alleyway.jpg";
import mntFuji from "../assets/photography/mnt_fuji.jpg";

// Originals in src/assets/photography are full camera resolution. Astro
// generates the grid thumbnails and the lightbox version at build time.
const LIGHTBOX_LONG_EDGE = 2400;

async function lightboxSrc(image: ImageMetadata) {
  const scale = Math.min(
    1,
    LIGHTBOX_LONG_EDGE / Math.max(image.width, image.height),
  );
  const full = await getImage({
    src: image,
    width: Math.round(image.width * scale),
    format: "webp",
  });
  return full.src;
}

interface Post {
  title: string;
  /** "YYYY-MM", or just "YYYY". Posts are listed newest first. */
  date: string;
  text?: string;
  /** One photo is shown large; several are shown as a grid. */
  photos?: { image: ImageMetadata; alt: string }[];
  /** Button to an external album. */
  link?: { text: string; url: string };
}

// Add new posts anywhere in this list; they are sorted by date below.
const allPosts: Post[] = [
  {
    title: "Japan 2026",
    date: "2026",
    link: {
      text: "View the album on Google Photos ↗",
      url: "https://photos.app.goo.gl/3JvDXtwURSKwfL9k6",
    },
  },
  {
    title: "Japan 2025",
    date: "2025-12",
    photos: [
      { image: hills, alt: "Mt. Fuji with friends - Group" },
      { image: marketplace, alt: "Mt. Fuji with friends - Marketplace" },
      { image: alleyway, alt: "Mt. Fuji with friends - Alleyway" },
      { image: mntFuji, alt: "Mt. Fuji with friends - Pic of Mount Fuji" },
    ],
  },
  {
    title: "Grandfather Mountain",
    date: "2025-05",
    photos: [{ image: grandfatherMntPeak, alt: "Grandfather Mountain" }],
  },
];

function formatDate(date: string) {
  const [year, month] = date.split("-");
  if (!month) return year;
  return new Date(Number(year), Number(month) - 1).toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
  });
}

const posts = await Promise.all(
  allPosts
    .sort((a, b) => b.date.localeCompare(a.date))
    .map(async (post) => ({
      ...post,
      photos: await Promise.all(
        (post.photos ?? []).map(async (photo) => ({
          ...photo,
          full: await lightboxSrc(photo.image),
        })),
      ),
    })),
);
---

<Layout
  current="photography"
  heading="Photography"
  lead="Shot on a Canon EOS Rebel T7."
>
  <dialog id="lightbox" class="lightbox" aria-label="Photo viewer">
    <button
      class="lightbox-button lightbox-close"
      data-lightbox-close
      aria-label="Close">&times;</button
    >
    <button
      class="lightbox-button lightbox-prev"
      data-lightbox-prev
      aria-label="Previous photo">&larr;</button
    >
    <figure class="lightbox-figure" data-lightbox-figure>
      <div class="spinner" data-lightbox-spinner></div>
      <img data-lightbox-img alt="" hidden />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
    <button
      class="lightbox-button lightbox-next"
      data-lightbox-next
      aria-label="Next photo">&rarr;</button
    >
  </dialog>

  <div data-reveal>
    <a
      href="https://www.flickr.com/photos/04klin/"
      target="_blank"
      rel="noopener noreferrer"
      class="button"
    >
      View my full portfolio on Flickr ↗
    </a>
  </div>

  {
    posts.map((post) => (
      <article class="photo-post" data-reveal>
        <header class="photo-post-header">
          <h2>{post.title}</h2>
          <div class="mini-label">{formatDate(post.date)}</div>
        </header>
        {post.text && <p>{post.text}</p>}

        {post.photos.length > 0 && (
          <div
            class:list={[
              "photo-grid",
              { "photo-grid-single": post.photos.length === 1 },
            ]}
          >
            {post.photos.map((photo) => (
              <button
                type="button"
                class="photo-button lightbox-trigger"
                data-full={photo.full}
                data-caption={photo.alt}
                aria-label={`Enlarge photo: ${photo.alt}`}
              >
                <Image
                  src={photo.image}
                  alt={photo.alt}
                  width={post.photos.length === 1 ? 2000 : 1000}
                />
              </button>
            ))}
          </div>
        )}

        {post.link && (
          <a
            href={post.link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="button"
          >
            {post.link.text}
          </a>
        )}
      </article>
    ))
  }
</Layout>

<script>
  // Runs on every navigation to this page, including view transitions.
  document.addEventListener("astro:page-load", () => {
    const lightbox = document.querySelector<HTMLDialogElement>("#lightbox");
    if (!lightbox) return;

    const part = <T extends HTMLElement>(name: string) =>
      lightbox.querySelector<T>(`[data-lightbox-${name}]`)!;
    const image = part<HTMLImageElement>("img");
    const figure = part("figure");
    const caption = part("caption");
    const spinner = part("spinner");
    const prev = part("prev");
    const next = part("next");

    const triggers = Array.from(
      document.querySelectorAll<HTMLElement>(".lightbox-trigger"),
    );
    if (triggers.length === 0) return;
    prev.hidden = next.hidden = triggers.length < 2;

    let current = 0;
    const show = (index: number) => {
      current = (index + triggers.length) % triggers.length;
      const trigger = triggers[current];
      const text = trigger.dataset.caption ?? "";

      // Show the spinner until the larger image has downloaded
      spinner.hidden = false;
      image.hidden = true;
      image.alt = text;
      image.src = trigger.dataset.full ?? "";
      caption.textContent = `${text} · ${current + 1} / ${triggers.length}`;
    };

    image.addEventListener("load", () => {
      spinner.hidden = true;
      image.hidden = false;
    });

    triggers.forEach((trigger, index) => {
      trigger.addEventListener("click", () => {
        show(index);
        lightbox.showModal();
      });
    });

    prev.addEventListener("click", () => show(current - 1));
    next.addEventListener("click", () => show(current + 1));
    lightbox.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });

    part("close").addEventListener("click", () => lightbox.close());
    // Close when clicking outside the photo
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox || e.target === figure) lightbox.close();
    });
    // Cleared so the old photo does not flash the next time it opens
    lightbox.addEventListener("close", () => image.removeAttribute("src"));
  });
</script>
