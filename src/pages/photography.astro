---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { seasonOf } from "../scripts/seasons";

import grandfatherMntPeak from "../assets/photography/grandfather_mnt_peak.jpg";
import grandfatherMountainOutlook from "../assets/photography/grandfather_mountain_outlook.jpg";
import hills from "../assets/photography/hills.jpg";
import marketplace from "../assets/photography/marketplace.jpg";
import alleyway from "../assets/photography/alleyway.jpg";
import mntFuji from "../assets/photography/mnt_fuji.jpg";
import modelBakeryJapan from "../assets/photography/model_bakery_japan.jpg";
import tokyoNightView from "../assets/photography/tokyo_night_view.jpg";
import enoshimaEntrance from "../assets/photography/enoshima_entrance.jpg";
import enoshimaShore from "../assets/photography/enoshima_shore.jpg";
import brooklynBridge from "../assets/photography/brooklyn_bridge.jpg";
import littleIsland from "../assets/photography/little_island.jpg";
import linvilleGorgeSquatting from "../assets/photography/linville_gorge_squatting_at_outlook.jpg";
import linvilleGorgeHanging from "../assets/photography/linville_gorge_hanging.jpg";
import linvilleGorgeOutlook from "../assets/photography/linville_gorge_outlook.jpg";

// Originals in src/assets/photography are full camera resolution. Astro
// generates the grid thumbnails and the lightbox version at build time.
const LIGHTBOX_LONG_EDGE = 2400;

async function lightboxSrc(image: ImageMetadata) {
  const scale = Math.min(
    1,
    LIGHTBOX_LONG_EDGE / Math.max(image.width, image.height),
  );
  const full = await getImage({
    src: image,
    width: Math.round(image.width * scale),
    format: "webp",
  });
  return full.src;
}

interface Post {
  title: string;
  /** "YYYY-MM", or just "YYYY". Posts are listed newest first. */
  date: string;
  text?: string;
  /** One photo is shown large; several are shown as a grid. */
  photos?: { image: ImageMetadata; alt: string }[];
  /** Button to an external album. */
  link?: { text: string; url: string };
}

// Add new posts anywhere in this list; they are sorted by date below.
const allPosts: Post[] = [
  {
    title: "Linville Gorge",
    date: "2026-11",
    photos: [
      {
        image: linvilleGorgeHanging,
        alt: "A hiker gripping a boulder at the cliff edge above autumn forest",
      },
      {
        image: linvilleGorgeOutlook,
        alt: "Looking out over a lake and autumn-coloured hills from the gorge rim",
      },
      {
        image: linvilleGorgeSquatting,
        alt: "A hiker crouching on a rock ledge above the forested gorge on a cloudy day",
      },
    ],
  },
  {
    title: "NYC",
    date: "2026-06",
    photos: [
      {
        image: brooklynBridge,
        alt: "Brooklyn Bridge in front of the Lower Manhattan skyline",
      },
      {
        image: littleIsland,
        alt: "Little Island park on the Hudson River, with Manhattan behind it",
      },
    ],
  },
  {
    title: "Tokyo, Japan",
    date: "2026-05",
    photos: [
      { image: tokyoNightView, alt: "Tokyo lit up at night, seen from above" },
      {
        image: enoshimaEntrance,
        alt: "Me at the torii gate entrance to Enoshima",
      },
      {
        image: enoshimaShore,
        alt: "Red walkway along the cliffs of the Enoshima shore",
      },
      {
        image: modelBakeryJapan,
        alt: "A miniature model of a bakery full of bread",
      },
    ],
    link: {
      text: "Album on Google Photos",
      url: "https://photos.app.goo.gl/3JvDXtwURSKwfL9k6",
    },
  },
  {
    title: "Tokyo and Osaka, Japan",
    date: "2025-12",
    link: {
      text: "Album on Google Photos",
      url: "https://photos.app.goo.gl/5ZfrFPxRZssD6Bo97",
    },
    photos: [
      {
        image: hills,
        alt: "Friends looking out over a small town and the hills behind it",
      },
      {
        image: marketplace,
        alt: "A crowded street of traditional shops at sunset",
      },
      {
        image: alleyway,
        alt: "Friends walking down a quiet residential street",
      },
      {
        image: mntFuji,
        alt: "The snowy peak of Mount Fuji breaking through the clouds",
      },
    ],
  },
  {
    title: "Grandfather Mountain",
    date: "2025-05",
    photos: [
      {
        image: grandfatherMountainOutlook,
        alt: "Green valleys and ridges in spring under a sky full of clouds",
      },
      {
        image: grandfatherMntPeak,
        alt: "A hiker with arms raised at the summit, valleys spread out below",
      },
    ],
  },
];

function formatDate(date: string) {
  const [year, month] = date.split("-");
  if (!month) return year;
  return new Date(Number(year), Number(month) - 1).toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
  });
}

const posts = await Promise.all(
  allPosts
    .sort((a, b) => b.date.localeCompare(a.date))
    .map(async (post) => ({
      ...post,
      photos: await Promise.all(
        (post.photos ?? []).map(async (photo) => ({
          ...photo,
          full: await lightboxSrc(photo.image),
        })),
      ),
    })),
);
---

<Layout
  current="photography"
  heading="Photography"
  lead="Shot on a Canon EOS Rebel T7."
  description="Photography by Kevin Lin: mountains, streets and travel, shot on a Canon EOS Rebel T7."
>
  <dialog id="lightbox" class="lightbox" aria-label="Photo viewer">
    <button
      class="lightbox-button lightbox-close"
      data-lightbox-close
      aria-label="Close">&times;</button
    >
    <button
      class="lightbox-button lightbox-prev"
      data-lightbox-prev
      aria-label="Previous photo">&larr;</button
    >
    <figure class="lightbox-figure" data-lightbox-figure>
      <div class="spinner" data-lightbox-spinner></div>
      <img data-lightbox-img alt="" hidden />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
    <button
      class="lightbox-button lightbox-next"
      data-lightbox-next
      aria-label="Next photo">&rarr;</button
    >
  </dialog>

  <p class="link-row">
    <a
      href="https://www.flickr.com/photos/04klin/"
      target="_blank"
      rel="noopener noreferrer">More on Flickr</a
    >
  </p>

  {
    posts.map((post) => (
      <article class="photo-post" data-season-of={seasonOf(post.date)}>
        <header class="photo-post-header">
          <h2>{post.title}</h2>
          <p class="post-date">{formatDate(post.date)}</p>
        </header>
        {post.text && <p>{post.text}</p>}

        {post.photos.length > 0 && (
          <div class="photo-scroller">
            <div
              class:list={[
                "photo-grid",
                { "photo-grid-single": post.photos.length === 1 },
                { "photo-grid-pair": post.photos.length === 2 },
              ]}
            >
              {post.photos.map((photo) => (
                <button
                  type="button"
                  class="photo-button lightbox-trigger"
                  data-full={photo.full}
                  data-caption={photo.alt}
                  aria-label={`Enlarge photo: ${photo.alt}`}
                >
                  <Image
                    src={photo.image}
                    alt={photo.alt}
                    width={post.photos.length === 1 ? 2000 : 1000}
                  />
                </button>
              ))}
            </div>
            {post.photos.length > 1 && (
              <>
                <button
                  type="button"
                  class="photo-scroll-button photo-scroll-prev"
                  data-scroll="-1"
                  aria-label="Previous photos"
                  hidden
                >
                  &larr;
                </button>
                <button
                  type="button"
                  class="photo-scroll-button photo-scroll-next"
                  data-scroll="1"
                  aria-label="More photos"
                  hidden
                >
                  &rarr;
                </button>
              </>
            )}
          </div>
        )}

        {post.link && (
          <p class="link-row">
            <a href={post.link.url} target="_blank" rel="noopener noreferrer">
              {post.link.text}
            </a>
          </p>
        )}
      </article>
    ))
  }
</Layout>

<script>
  import { followPostSeasons } from "../scripts/scene";

  // The backdrop takes the season of the post being looked at.
  let stopSeasons: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    stopSeasons?.();
    stopSeasons = followPostSeasons();
  });
  document.addEventListener("astro:before-swap", () => {
    stopSeasons?.();
    stopSeasons = undefined;
  });
</script>

<script>
  // Arrow buttons beside each sideways-scrolling row of photos. They stay
  // hidden without JavaScript, and when the row has nothing to scroll.
  let rowObserver: ResizeObserver | undefined;
  document.addEventListener("astro:before-swap", () =>
    rowObserver?.disconnect(),
  );

  document.addEventListener("astro:page-load", () => {
    const scrollers = document.querySelectorAll<HTMLElement>(".photo-scroller");
    if (scrollers.length === 0) return;
    const smooth = window.matchMedia("(prefers-reduced-motion: no-preference)");
    const updates = new Map<Element, () => void>();
    rowObserver = new ResizeObserver((entries) =>
      entries.forEach((entry) => updates.get(entry.target)?.()),
    );

    scrollers.forEach((scroller) => {
      const row = scroller.querySelector<HTMLElement>(".photo-grid")!;
      const buttons =
        scroller.querySelectorAll<HTMLButtonElement>("[data-scroll]");
      if (buttons.length === 0) return;

      const update = () => {
        const max = row.scrollWidth - row.clientWidth;
        buttons.forEach((button) => {
          const forward = button.dataset.scroll === "1";
          button.hidden = max <= 1;
          button.disabled = forward
            ? row.scrollLeft >= max - 1
            : row.scrollLeft <= 1;
        });
      };

      buttons.forEach((button) =>
        button.addEventListener("click", () => {
          const photo = row.firstElementChild as HTMLElement;
          const gap = parseFloat(getComputedStyle(row).columnGap) || 0;
          row.scrollBy({
            left: Number(button.dataset.scroll) * (photo.offsetWidth + gap),
            behavior: smooth.matches ? "smooth" : "auto",
          });
        }),
      );
      row.addEventListener("scroll", update, { passive: true });
      updates.set(row, update);
      rowObserver!.observe(row);
      update();
    });
  });

  // Runs on every navigation to this page, including view transitions.
  document.addEventListener("astro:page-load", () => {
    const lightbox = document.querySelector<HTMLDialogElement>("#lightbox");
    if (!lightbox) return;

    const part = <T extends HTMLElement>(name: string) =>
      lightbox.querySelector<T>(`[data-lightbox-${name}]`)!;
    const image = part<HTMLImageElement>("img");
    const figure = part("figure");
    const caption = part("caption");
    const spinner = part("spinner");
    const prev = part("prev");
    const next = part("next");

    const triggers = Array.from(
      document.querySelectorAll<HTMLElement>(".lightbox-trigger"),
    );
    if (triggers.length === 0) return;
    prev.hidden = next.hidden = triggers.length < 2;

    let current = 0;
    const show = (index: number) => {
      current = (index + triggers.length) % triggers.length;
      const trigger = triggers[current];
      const text = trigger.dataset.caption ?? "";

      // Show the spinner until the larger image has downloaded
      spinner.hidden = false;
      image.hidden = true;
      image.alt = text;
      image.src = trigger.dataset.full ?? "";
      caption.textContent = `${text} · ${current + 1} / ${triggers.length}`;
    };

    image.addEventListener("load", () => {
      spinner.hidden = true;
      image.hidden = false;
    });

    triggers.forEach((trigger, index) => {
      trigger.addEventListener("click", () => {
        show(index);
        lightbox.showModal();
      });
    });

    prev.addEventListener("click", () => show(current - 1));
    next.addEventListener("click", () => show(current + 1));
    lightbox.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });

    part("close").addEventListener("click", () => lightbox.close());
    // Close when clicking outside the photo
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox || e.target === figure) lightbox.close();
    });
    // Cleared so the old photo does not flash the next time it opens
    lightbox.addEventListener("close", () => image.removeAttribute("src"));
  });
</script>
