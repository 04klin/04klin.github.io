---
import Layout from "../layouts/Layout.astro";
import Prompt from "../components/Prompt.astro";
---

<!-- GitHub Pages serves the built 404.html for any path that does not exist. -->
<Layout title="404">
  <div class="term term-404">
    <p class="term-line">
      <Prompt /> cd <span data-missing-path>that-page</span>
    </p>
    <p class="term-err">cd: no such file or directory</p>
    <p class="term-line"><Prompt /> <a href="/">cd ~</a></p>
  </div>
</Layout>

<script>
  // Names the path that was asked for.
  document.addEventListener("astro:page-load", () => {
    const slot = document.querySelector("[data-missing-path]");
    if (slot) slot.textContent = decodeURIComponent(location.pathname);
  });
</script>
