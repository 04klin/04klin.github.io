---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import mntFuji from "../assets/photography/mnt_fuji.jpg";
---

<!-- GitHub Pages serves the built 404.html for any path that does not exist. -->
<Layout heading="404" lead="This page wandered off the trail.">
  <section class="not-found">
    <p class="link-row">
      <a href="/">Take me home</a>
      <a href="/projects">Projects</a>
      <a href="/photography">Photography</a>
    </p>

    <figure class="not-found-photo">
      <Image
        src={mntFuji}
        alt="Mt. Fuji, mostly hidden by clouds"
        width={1400}
        height={600}
        fit="cover"
        loading="eager"
      />
      <figcaption>Searched up here too. Nothing but clouds.</figcaption>
    </figure>
  </section>
</Layout>
