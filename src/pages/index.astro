---
import Layout from "../layouts/Layout.astro";
import Shell from "../components/Shell.astro";
---

<Layout walk>
  <Shell />
</Layout>

<script>
  import { setupPhotos } from "../scripts/photos";
  import { setupResume } from "../scripts/resume";
  import { setupSettings } from "../scripts/settings";
  import { setupShell } from "../scripts/shell";
  import { setupWindows } from "../scripts/windows";

  document.addEventListener("astro:page-load", () => {
    setupWindows();
    setupPhotos();
    setupResume();
    setupSettings();
    setupShell();
  });
</script>
