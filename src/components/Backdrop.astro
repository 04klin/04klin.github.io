---
/*
 * The fixed page background. It holds four landscapes: mountains, a river
 * valley, a lake and rolling hills. The inline script in the layout's <head>
 * picks one per visit and sets the season and day or night on <html>; the
 * CSS then shows that landscape in the season's colours, with the season's
 * extras (snow caps, falling petals, leaves or snow, summer fireflies).
 *
 * Every shape is drawn here at build time from a fixed seed, so each
 * landscape looks the same on every build, and ships as static SVG.
 */

const W = 1440;
const H = 400;
const round = Math.round;

type Point = [number, number];
type Random = () => number;

/** A seeded random number generator: the same seed gives the same shapes. */
function seeded(seed: number): Random {
  let s = seed;
  return () => (s = (s * 16807) % 2147483647) / 2147483647;
}

const pt = ([x, y]: Point) => `${round(x)} ${round(y)}`;
const range = (from: number, to: number, step: number) => {
  const values: number[] = [];
  for (let v = from; v <= to; v += step) values.push(v);
  return values;
};

/** A closed shape with straight edges through the points. */
const polygon = (points: Point[]) => `M${points.map(pt).join(" L")} Z`;

/** A shape whose top is a smooth curve through the points, filled down. */
function smoothHill(points: Point[]) {
  let d = `M${round(points[0][0])} ${H} L${pt(points[0])}`;
  for (let i = 1; i < points.length - 1; i++) {
    const [x0, y0] = points[i];
    const [x1, y1] = points[i + 1];
    d += ` Q${pt([x0, y0])} ${pt([(x0 + x1) / 2, (y0 + y1) / 2])}`;
  }
  const last = points[points.length - 1];
  return `${d} L${pt(last)} L${round(last[0])} ${H} Z`;
}

/** A soft ridgeline of random heights. */
const ridge = (random: Random, base: number, amp: number, step: number) =>
  smoothHill(
    range(-step, W + step, step).map((x) => [x, base - random() * amp]),
  );

/** The ground along a line, filled down to the bottom. */
const ground = (y: (x: number) => number, from = 0, to = W) =>
  polygon([
    [from, H],
    ...range(from, to, 20).map((x): Point => [x, Math.min(y(x), H + 5)]),
    [to, y(to)],
    [to, H],
  ]);

/**
 * A mountain range of sharp peaks and saddles, and snow caps for the taller
 * peaks (shown in winter).
 */
function mountains(random: Random, base: number, amp: number, step: number) {
  const points: Point[] = [
    [0, H],
    [0, base],
  ];
  const peaks: [Point, Point, Point][] = [];
  let previous: Point = [0, base];
  for (let x = 0; x <= W + step; x += step) {
    const height = amp * (0.45 + random() * 0.55);
    const peak: Point = [x + step * (0.35 + random() * 0.3), base - height];
    const saddle: Point = [x + step, base - amp * random() * 0.3];
    points.push(peak, saddle);
    peaks.push([previous, peak, saddle]);
    previous = saddle;
  }
  points.push([previous[0], H]);

  // Snow lies above one snow line for the whole range, so taller peaks get
  // deeper caps and peaks below it get none. The caps' own random numbers
  // keep the range's shapes the same whatever the caps do.
  const snowLine = base - amp * 0.62;
  const capRandom = seeded(round(base * 7 + amp));
  const caps = peaks
    .filter(([, peak]) => peak[1] < snowLine - 10)
    .map(([before, peak, after]) => {
      // Where each slope crosses the snow line.
      const cross = (to: Point): Point => {
        const f = (snowLine - peak[1]) / (to[1] - peak[1]);
        return [peak[0] + (to[0] - peak[0]) * f, snowLine];
      };
      const left = cross(before);
      const right = cross(after);
      // The lower edge dips into a few drifts, never above the snow line.
      const drift = (f: number): Point => [
        left[0] + (right[0] - left[0]) * f,
        snowLine + 2 + capRandom() * 6,
      ];
      return polygon([peak, right, drift(0.7), drift(0.45), drift(0.2), left]);
    });

  return { shape: polygon(points), caps: caps.join(" ") };
}

interface ForestOptions {
  from?: number;
  to?: number;
  /** Smallest and largest step between trees. */
  gap: [number, number];
  /** Share of round leafy trees; the rest are pines. */
  broadleaf: number;
  scale?: number;
  /** Leaves out a tree, for example where a river runs. */
  skip?: (x: number, groundY: number) => boolean;
}

/**
 * Trees standing on a ground line: pines (green all year) and round leafy
 * trees (whose colour follows the season), as two shapes.
 */
function forest(random: Random, y: (x: number) => number, o: ForestOptions) {
  const { from = 0, to = W, gap, broadleaf, scale = 1, skip } = o;
  let pines = "";
  let leaves = "";
  for (let x = from; x < to; x += gap[0] + random() * (gap[1] - gap[0])) {
    const g = y(x) + 2;
    const isLeafy = random() < broadleaf;
    const width = (isLeafy ? 22 + random() * 20 : 14 + random() * 16) * scale;
    const height = (isLeafy ? 20 + random() * 26 : 30 + random() * 55) * scale;
    if (skip?.(x, g)) continue;
    if (isLeafy) {
      const r = `${round(width / 2)} ${round(height)}`;
      leaves += ` M${pt([x - width / 2, g])} A${r} 0 0 1 ${pt([x + width / 2, g])} Z`;
    } else {
      pines += ` ${polygon([
        [x - width / 2, g],
        [x, g - height],
        [x + width / 2, g],
      ])}`;
    }
  }
  return { pines, leaves };
}

/* Mountains: a range of peaks, rolling foothills and a pine forest. */
const mountainScene = (() => {
  const random = seeded(7);
  const groundY = (x: number) => 330 + Math.sin(x / 180) * 10;
  return {
    far: mountains(random, 220, 140, 150),
    mid: ridge(random, 262, 70, 120),
    ground: ground(groundY),
    trees: forest(random, groundY, { gap: [8, 22], broadleaf: 0.35 }),
  };
})();

/* River valley: hills slope down to a river that winds towards the viewer. */
const riverScene = (() => {
  const random = seeded(11);
  const top = 262;
  const valley = (x: number) => top - 75 * Math.abs((x - 720) / 720) ** 1.3;
  // t runs from the far end of the river (0) to the bottom edge (1).
  const centre = (t: number) => 720 + Math.sin(t * 3.4 + 0.5) * 110 * t;
  const width = (t: number) => 3 + 320 * t ** 1.8;
  const ts = range(0, 1.04, 0.04);
  const bank = (side: number) =>
    ts.map(
      (t): Point => [centre(t) + (side * width(t)) / 2, top + (H - top) * t],
    );
  const groundY = (x: number) => 336 + Math.sin(x / 150) * 8;
  const glints = Array.from({ length: 6 }, () => {
    const t = 0.55 + random() * 0.4;
    const x = centre(t) + (random() - 0.5) * width(t) * 0.5;
    const y = top + (H - top) * t;
    const half = 6 + width(t) * 0.08;
    return `M${pt([x - half, y])} L${pt([x + half, y])}`;
  }).join(" ");
  return {
    far: mountains(random, 215, 95, 190),
    mid: smoothHill(
      range(-40, W + 40, 60).map((x): Point => [x, valley(x) - random() * 14]),
    ),
    ground: ground(groundY),
    water: polygon([...bank(-1), ...bank(1).reverse()]),
    glints,
    trees: forest(random, groundY, {
      gap: [8, 22],
      broadleaf: 0.45,
      skip: (x, g) => {
        const t = (g - top) / (H - top);
        return Math.abs(x - centre(t)) < width(t) / 2 + 14;
      },
    }),
  };
})();

/* Lake: still water reflecting the mountains, with wooded shores. */
const LAKE_SHORE = 290;
const lakeScene = (() => {
  const random = seeded(23);
  const reach = 380;
  const leftY = (x: number) => LAKE_SHORE + 28 + (x / reach) ** 2 * 110;
  const rightY = (x: number) => LAKE_SHORE + 28 + ((W - x) / reach) ** 2 * 110;
  const onShore = (_: number, g: number) => g > H - 18;
  const left = forest(random, leftY, {
    to: reach,
    gap: [8, 20],
    broadleaf: 0.4,
    skip: onShore,
  });
  const right = forest(random, rightY, {
    from: W - reach,
    gap: [8, 20],
    broadleaf: 0.4,
    skip: onShore,
  });
  const glints = Array.from({ length: 9 }, () => {
    const x = 380 + random() * 680;
    const y = LAKE_SHORE + 14 + random() * (H - LAKE_SHORE - 20);
    const half = 8 + random() * 26;
    return `M${pt([x - half, y])} L${pt([x + half, y])}`;
  }).join(" ");
  return {
    far: mountains(random, 240, 150, 170),
    mid: ridge(random, LAKE_SHORE + 2, 22, 110),
    shores: `${ground(leftY, 0, reach)} ${ground(rightY, W - reach, W)}`,
    glints,
    trees: {
      pines: left.pines + right.pines,
      leaves: left.leaves + right.leaves,
    },
  };
})();

/* Rolling hills: soft green hills dotted with trees. */
const hillScene = (() => {
  const random = seeded(31);
  const midY = (x: number) =>
    285 + Math.sin(x / 210 + 1) * 22 + Math.sin(x / 90) * 5;
  const groundY = (x: number) =>
    342 + Math.sin(x / 260) * 20 + Math.sin(x / 97 + 2) * 6;
  const far = forest(random, midY, {
    gap: [30, 120],
    broadleaf: 0.7,
    scale: 0.55,
  });
  const near = forest(random, groundY, { gap: [40, 170], broadleaf: 0.75 });
  return {
    far: ridge(random, 238, 45, 260),
    mid: smoothHill(range(-60, W + 60, 60).map((x): Point => [x, midY(x)])),
    ground: ground(groundY),
    trees: { pines: far.pines + near.pines, leaves: far.leaves + near.leaves },
  };
})();

/* The sky and the falling things. Their own seed keeps the landscapes
   unchanged if these change. */
const random = seeded(99);

const stars = Array.from({ length: 40 }, () => ({
  left: `${(random() * 100).toFixed(1)}%`,
  top: `${(random() * 45).toFixed(1)}%`,
  opacity: (0.15 + random() * 0.35).toFixed(2),
}));

const clouds = Array.from({ length: 5 }, (_, i) => ({
  left: `${round(i * 20 + random() * 12 - 10)}%`,
  top: `${round(6 + random() * 30)}%`,
  width: `${round(220 + random() * 220)}px`,
  height: `${round(50 + random() * 40)}px`,
  delay: `${(-random() * 70).toFixed(1)}s`,
}));

const fireflies = Array.from({ length: 14 }, () => ({
  left: `${round(4 + random() * 92)}%`,
  bottom: `${round(4 + random() * 14)}vh`,
  delay: `${(-random() * 8).toFixed(1)}s`,
  duration: `${(6 + random() * 6).toFixed(1)}s`,
}));

/** Petals, leaves or snowflakes falling from above the top of the screen. */
const falling = (count: number, speed: [number, number], spin: boolean) =>
  Array.from({ length: count }, () => {
    const duration = speed[0] + random() * (speed[1] - speed[0]);
    return [
      `left:${(random() * 100).toFixed(1)}%`,
      `animation-duration:${duration.toFixed(1)}s`,
      `animation-delay:${(-random() * duration).toFixed(1)}s`,
      `--drift:${round((random() - 0.5) * 240)}px`,
      `--spin:${spin ? round(240 + random() * 600) : 0}deg`,
      `--size:${(0.6 + random() * 0.8).toFixed(2)}`,
    ].join(";");
  });

const petals = falling(18, [14, 24], true);
const leaves = falling(16, [12, 20], true);
const snow = falling(46, [10, 22], false);

const viewBox = `0 0 ${W} ${H}`;
const fit = "xMidYMax slice";
---

<div class="backdrop" aria-hidden="true" transition:persist="backdrop">
  <div class="sky-day"></div>
  <div class="stars">
    {
      stars.map((star) => (
        <span
          style={`left:${star.left};top:${star.top};opacity:${star.opacity}`}
        />
      ))
    }
  </div>
  <div class="moon"></div>
  <div class="sun"></div>
  <div class="clouds">
    {
      clouds.map((c) => (
        <span
          style={`left:${c.left};top:${c.top};width:${c.width};height:${c.height};animation-delay:${c.delay}`}
        />
      ))
    }
  </div>
  <div class="mist mist-a"></div>

  <svg
    class="landscape landscape-mountains"
    viewBox={viewBox}
    preserveAspectRatio={fit}
  >
    <path class="far" d={mountainScene.far.shape}></path>
    <path class="snowcap" d={mountainScene.far.caps}></path>
    <path class="mid" d={mountainScene.mid}></path>
    <path class="ground" d={mountainScene.ground}></path>
    <path class="leaf" d={mountainScene.trees.leaves}></path>
    <path class="pine" d={mountainScene.trees.pines}></path>
  </svg>

  <svg
    class="landscape landscape-river"
    viewBox={viewBox}
    preserveAspectRatio={fit}
  >
    <path class="far" d={riverScene.far.shape}></path>
    <path class="snowcap" d={riverScene.far.caps}></path>
    <path class="mid" d={riverScene.mid}></path>
    <path class="ground" d={riverScene.ground}></path>
    <path class="water" d={riverScene.water}></path>
    <path class="glint" d={riverScene.glints}></path>
    <path class="leaf" d={riverScene.trees.leaves}></path>
    <path class="pine" d={riverScene.trees.pines}></path>
  </svg>

  <svg
    class="landscape landscape-lake"
    viewBox={viewBox}
    preserveAspectRatio={fit}
  >
    <clipPath id="lake-water">
      <rect x="0" y={LAKE_SHORE} width={W} height={H - LAKE_SHORE}></rect>
    </clipPath>
    <path class="far" d={lakeScene.far.shape}></path>
    <path class="snowcap" d={lakeScene.far.caps}></path>
    <path class="mid" d={lakeScene.mid}></path>
    <rect class="water" x="0" y={LAKE_SHORE} width={W} height={H - LAKE_SHORE}
    ></rect>
    <!-- The mountains mirrored in the still water. -->
    <g class="reflection" clip-path="url(#lake-water)">
      <g transform={`translate(0 ${2 * LAKE_SHORE}) scale(1 -1)`}>
        <path class="far" d={lakeScene.far.shape}></path>
        <path class="snowcap" d={lakeScene.far.caps}></path>
        <path class="mid" d={lakeScene.mid}></path>
      </g>
    </g>
    <path class="glint" d={lakeScene.glints}></path>
    <path class="ground" d={lakeScene.shores}></path>
    <path class="leaf" d={lakeScene.trees.leaves}></path>
    <path class="pine" d={lakeScene.trees.pines}></path>
  </svg>

  <svg
    class="landscape landscape-hills"
    viewBox={viewBox}
    preserveAspectRatio={fit}
  >
    <path class="far" d={hillScene.far}></path>
    <path class="mid" d={hillScene.mid}></path>
    <path class="ground" d={hillScene.ground}></path>
    <path class="leaf" d={hillScene.trees.leaves}></path>
    <path class="pine" d={hillScene.trees.pines}></path>
  </svg>

  <div class="mist mist-b"></div>

  <div class="fireflies">
    {
      fireflies.map((f) => (
        <span
          style={`left:${f.left};bottom:${f.bottom};animation-delay:${f.delay};animation-duration:${f.duration}`}
        />
      ))
    }
  </div>
  <div class="falling petals">
    {petals.map((style) => <span style={style} />)}
  </div>
  <div class="falling leaves">
    {leaves.map((style) => <span style={style} />)}
  </div>
  <div class="falling snow">{snow.map((style) => <span style={style} />)}</div>
</div>
