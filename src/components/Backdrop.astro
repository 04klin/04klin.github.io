---
/*
 * The fixed page background. It holds four landscapes: mountains, a river
 * valley, a lake and rolling hills. The inline script in the layout's <head>
 * picks one per visit and sets the season and day or night on <html>; the
 * CSS then shows that landscape in the season's colours, with the season's
 * extras (snow caps, falling petals, leaves or snow, summer fireflies).
 *
 * Every shape is drawn here at build time from a fixed seed, so each
 * landscape looks the same on every build, and ships as static SVG.
 */

const W = 1440;
const H = 400;
const round = Math.round;

type Point = [number, number];
type Random = () => number;

/** A seeded random number generator: the same seed gives the same shapes. */
function seeded(seed: number): Random {
  let s = seed;
  return () => (s = (s * 16807) % 2147483647) / 2147483647;
}

const pt = ([x, y]: Point) => `${round(x)} ${round(y)}`;
const range = (from: number, to: number, step: number) => {
  const values: number[] = [];
  for (let v = from; v <= to; v += step) values.push(v);
  return values;
};

/** A closed shape with straight edges through the points. */
const polygon = (points: Point[]) => `M${points.map(pt).join(" L")} Z`;

/** A shape whose top is a smooth curve through the points, filled down. */
function smoothHill(points: Point[]) {
  let d = `M${round(points[0][0])} ${H} L${pt(points[0])}`;
  for (let i = 1; i < points.length - 1; i++) {
    const [x0, y0] = points[i];
    const [x1, y1] = points[i + 1];
    d += ` Q${pt([x0, y0])} ${pt([(x0 + x1) / 2, (y0 + y1) / 2])}`;
  }
  const last = points[points.length - 1];
  return `${d} L${pt(last)} L${round(last[0])} ${H} Z`;
}

/** The points of a soft ridgeline of random heights. */
const ridgePoints = (
  random: Random,
  base: number,
  amp: number,
  step: number,
): Point[] =>
  range(-step, W + step, step).map((x) => [x, base - random() * amp]);

/** A soft ridgeline of random heights. */
const ridge = (random: Random, base: number, amp: number, step: number) =>
  smoothHill(ridgePoints(random, base, amp, step));

/** A smooth curve through the points, as a height for every x. */
function curve(points: Point[]) {
  return (x: number) => {
    let i = 0;
    while (i < points.length - 2 && points[i + 1][0] < x) i++;
    const [[x0, y0], [x1, y1]] = [points[i], points[i + 1]];
    const t = Math.min(1, Math.max(0, (x - x0) / (x1 - x0)));
    return y0 + (y1 - y0) * (1 - Math.cos(Math.PI * t)) * 0.5;
  };
}

/**
 * A rough line from a to b (b left out): each pass splits every segment and
 * pushes the new midpoint sideways by up to `rough` times the segment's
 * length, less on each pass, the way real ridgelines and gullies wander.
 */
function jag(random: Random, a: Point, b: Point, rough: number, passes = 4) {
  let line: Point[] = [a, b];
  let spread = rough;
  for (let pass = 0; pass < passes; pass++) {
    const next: Point[] = [];
    for (let i = 0; i < line.length - 1; i++) {
      const [p, q] = [line[i], line[i + 1]];
      const [dx, dy] = [q[0] - p[0], q[1] - p[1]];
      const off = (random() - 0.5) * 2 * spread;
      next.push(p, [p[0] + dx / 2 - dy * off, p[1] + dy / 2 + dx * off]);
    }
    next.push(line[line.length - 1]);
    line = next;
    spread *= 0.55;
  }
  return line.slice(0, -1);
}

/**
 * Land along a line whose top edge is a distant forest: a dense row of tiny
 * pine tips and rounded crowns, so far hills read as wooded, not as smooth
 * blobs. `size` scales the trees (smaller further away).
 */
function treeline(random: Random, y: (x: number) => number, size: number) {
  const points: Point[] = [[-20, H]];
  for (let x = -20; x <= W + 20; ) {
    const w = (3 + random() * 5) * size;
    const h = (2 + random() * 7) * size;
    const g = y(x);
    if (random() < 0.7) {
      points.push([x, g], [x + w / 2, g - h], [x + w, g]);
    } else {
      points.push(
        [x, g],
        [x + w * 0.15, g - h * 0.6],
        [x + w * 0.5, g - h * 0.75],
        [x + w * 0.85, g - h * 0.6],
        [x + w, g],
      );
    }
    x += w * (0.7 + random() * 0.6);
  }
  points.push([W + 20, H]);
  return polygon(points);
}

/** The ground along a line, filled down to the bottom. */
const ground = (y: (x: number) => number, from = 0, to = W) =>
  polygon([
    [from, H],
    ...range(from, to, 20).map((x): Point => [x, Math.min(y(x), H + 5)]),
    [to, y(to)],
    [to, H],
  ]);

/**
 * A mountain range of sharp peaks and saddles with rough, wandering
 * ridgelines; snow caps that follow the rock down into the gullies (shown
 * in winter); a shaded face on each peak, the left slope away from the sun
 * or moon (on the right of the sky), down a crooked crease; and fainter
 * gullies furrowing the lit faces, so the range reads as solid rock.
 */
function mountains(random: Random, base: number, amp: number, step: number) {
  const peaks: [Point, Point, Point][] = [];
  let previous: Point = [0, base];
  for (let x = 0; x <= W + step; x += step) {
    const height = amp * (0.45 + random() * 0.55);
    const peak: Point = [x + step * (0.35 + random() * 0.3), base - height];
    const saddle: Point = [x + step, base - amp * random() * 0.3];
    peaks.push([previous, peak, saddle]);
    previous = saddle;
  }

  // The detail has its own random numbers, so the peaks stay where they
  // were, and whatever the detail does, the rest of the scene too.
  const detail = seeded(round(base * 13 + amp * 3 + step));
  // Never above its own peak, so each summit stays the top.
  const below = (top: Point) => (line: Point[]) =>
    line.map(([x, y], i): Point => [x, i === 0 ? y : Math.max(y, top[1] + 3)]);
  const slopes = peaks.map(([before, peak, after]) => ({
    left: below(peak)(jag(detail, before, peak, 0.09)),
    right: [peak, ...below(peak)(jag(detail, peak, after, 0.09).slice(1))],
  }));

  const outline: Point[] = [[0, H]];
  slopes.forEach(({ left, right }) => outline.push(...left, ...right));
  outline.push([previous[0], previous[1]], [previous[0], H]);

  // Snow lies above one snow line for the whole range, so taller peaks get
  // deeper caps and peaks below it get none. From the summit, the cap
  // follows each slope down to the snow line, and its lower edge reaches
  // down in fingers, as snow lies longest in the gullies.
  const snowLine = base - amp * 0.62;
  const caps = peaks
    .map(([, peak], i) => {
      if (peak[1] >= snowLine - 10) return "";
      const { left, right } = slopes[i];
      const down = (side: Point[]) => {
        const kept: Point[] = [];
        for (const p of side) {
          if (p[1] > snowLine) break;
          kept.push(p);
        }
        return kept;
      };
      const leftUp = down([...left].reverse()).reverse();
      const rightDown = down(right);
      const [l, r] = [leftUp[0] ?? peak, rightDown[rightDown.length - 1]];
      const edge = range(1, 7, 1).map((k): Point => {
        const finger = k % 2 === 0 ? amp * (0.06 + detail() * 0.12) : 0;
        return [
          r[0] + ((l[0] - r[0]) * k) / 8,
          snowLine + 2 + detail() * amp * 0.05 + finger,
        ];
      });
      return polygon([...leftUp, ...rightDown, ...edge]);
    })
    .filter(Boolean);

  const shade = peaks
    .map(([before, peak], i) => {
      const foot: Point = [
        peak[0] - (peak[0] - before[0]) * (0.2 + detail() * 0.2),
        base + amp * 0.25,
      ];
      return polygon([
        ...slopes[i].left,
        ...jag(detail, peak, foot, 0.12, 3),
        foot,
      ]);
    })
    .join(" ");

  // One or two gullies down each lit face: thin wedges that widen downhill.
  const gullies = peaks
    .flatMap(([, peak, after], i) => {
      const right = slopes[i].right;
      return range(1, 1 + round(detail()), 1).map(() => {
        const top = right[1 + Math.floor(detail() * (right.length / 2))];
        const reach = (after[0] - peak[0]) * (0.15 + detail() * 0.25);
        const foot: Point = [top[0] - reach, base + amp * 0.25];
        const width = 6 + detail() * 14;
        return polygon([
          ...jag(detail, top, foot, 0.1, 3),
          foot,
          [foot[0] + width, foot[1]],
        ]);
      });
    })
    .join(" ");

  return { shape: polygon(outline), caps: caps.join(" "), shade, gullies };
}

interface ForestOptions {
  from?: number;
  to?: number;
  /** Smallest and largest step between trees. */
  gap: [number, number];
  /** Share of round leafy trees; the rest are pines. */
  broadleaf: number;
  scale?: number;
  /** Leaves out a tree, for example where a river runs. */
  skip?: (x: number, groundY: number) => boolean;
}

/** A circle, as part of a path. */
const circle = ([cx, cy]: Point, r: number) =>
  `M${pt([cx - r, cy])} A${round(r)} ${round(r)} 0 1 0 ${pt([cx + r, cy])} A${round(r)} ${round(r)} 0 1 0 ${pt([cx - r, cy])} Z`;

/** The left half of a circle, the side away from the light. */
const leftHalf = ([cx, cy]: Point, r: number) =>
  `M${pt([cx, cy - r])} A${round(r)} ${round(r)} 0 0 0 ${pt([cx, cy + r])} Z`;

/**
 * Trees standing on a ground line: pines (green all year), drawn as tiers
 * of drooping boughs on a short trunk, and broadleaf trees (whose colour
 * follows the season), drawn as a clump of rounded crowns. Each comes as
 * shapes plus the half turned away from the light. The shapes' random
 * numbers come from their own generator, so the trees stand where they
 * always did.
 */
function forest(random: Random, y: (x: number) => number, o: ForestOptions) {
  const { from = 0, to = W, gap, broadleaf, scale = 1, skip } = o;
  const detail = seeded(round(from + to + gap[0] * 31 + broadleaf * 97));
  let pines = "";
  let leaves = "";
  let shade = "";
  for (let x = from; x < to; x += gap[0] + random() * (gap[1] - gap[0])) {
    const g = y(x) + 2;
    const isLeafy = random() < broadleaf;
    const width = (isLeafy ? 22 + random() * 20 : 14 + random() * 16) * scale;
    const height = (isLeafy ? 20 + random() * 26 : 30 + random() * 55) * scale;
    if (skip?.(x, g)) continue;
    if (isLeafy) {
      // A main crown and a few smaller ones round its lower sides.
      const r = Math.min(width / 2, height / 2.2);
      const crown: Point = [x, g - height + r];
      const lobes: [Point, number][] = [[crown, r]];
      const count = 2 + Math.floor(detail() * 3);
      for (let k = 0; k < count; k++) {
        const angle = Math.PI * (0.15 + detail() * 0.7) * (k % 2 ? 1 : -1);
        const lobe = r * (0.5 + detail() * 0.2);
        lobes.push([
          [
            crown[0] + Math.sin(angle) * r * 0.65,
            crown[1] + Math.abs(Math.cos(angle)) * r * 0.45,
          ],
          lobe,
        ]);
      }
      const trunk = Math.max(1, width * 0.06);
      const crownFoot = Math.min(g, crown[1] + r * 0.8);
      leaves += lobes.map(([c, lr]) => ` ${circle(c, lr)}`).join("");
      shade += lobes.map(([c, lr]) => ` ${leftHalf(c, lr)}`).join("");
      if (g - crownFoot > 1)
        shade += ` ${polygon([
          [x - trunk, crownFoot],
          [x + trunk, crownFoot],
          [x + trunk, g],
          [x - trunk, g],
        ])}`;
    } else {
      // Tiers of boughs, widest at the bottom, each drooping at its tips.
      const tiers = Math.min(5, 3 + Math.floor(height / 24));
      const foot = g - height * 0.07;
      const trunk = Math.max(1, width * 0.06);
      const edge: Point[] = [];
      for (let k = 1; k <= tiers; k++) {
        const ty = g - height + ((foot - (g - height)) * k) / tiers;
        const reach = (width / 2) * (k / tiers) * (0.85 + detail() * 0.3);
        edge.push([reach, ty + height * 0.02]);
        if (k < tiers) edge.push([reach * 0.45, ty - height * 0.02]);
      }
      const top: Point = [x, g - height];
      const left = edge.map(([dx, ey]): Point => [x - dx, ey]);
      const right = edge.map(([dx, ey]): Point => [x + dx, ey]).reverse();
      pines += ` ${polygon([
        top,
        ...left,
        [x - trunk, foot],
        [x - trunk, g],
        [x + trunk, g],
        [x + trunk, foot],
        ...right,
      ])}`;
      shade += ` ${polygon([top, ...left, [x - trunk, foot], [x - trunk, g], [x, g]])}`;
    }
  }
  return { pines, leaves, shade };
}

/* Mountains: a range of peaks, rolling foothills and a pine forest. */
const mountainScene = (() => {
  const random = seeded(7);
  const groundY = (x: number) => 330 + Math.sin(x / 180) * 10;
  return {
    back: mountains(seeded(107), 185, 150, 105),
    far: mountains(random, 220, 140, 150),
    mid: treeline(seeded(207), curve(ridgePoints(random, 262, 70, 120)), 1),
    ground: ground(groundY),
    trees: forest(random, groundY, { gap: [8, 22], broadleaf: 0.35 }),
    backTrees: forest(seeded(307), (x) => groundY(x) - 7, {
      gap: [5, 13],
      broadleaf: 0.3,
      scale: 0.6,
    }),
  };
})();

/* River valley: hills slope down to a river that winds towards the viewer. */
const riverScene = (() => {
  const random = seeded(11);
  const top = 262;
  const valley = (x: number) => top - 75 * Math.abs((x - 720) / 720) ** 1.3;
  // t runs from the far end of the river (0) to the bottom edge (1).
  const centre = (t: number) => 720 + Math.sin(t * 3.4 + 0.5) * 110 * t;
  const width = (t: number) => 3 + 320 * t ** 1.8;
  const ts = range(0, 1.04, 0.04);
  const bank = (side: number) =>
    ts.map(
      (t): Point => [centre(t) + (side * width(t)) / 2, top + (H - top) * t],
    );
  const groundY = (x: number) => 336 + Math.sin(x / 150) * 8;
  const back = mountains(seeded(111), 190, 120, 120);
  const glints = Array.from({ length: 6 }, () => {
    const t = 0.55 + random() * 0.4;
    const x = centre(t) + (random() - 0.5) * width(t) * 0.5;
    const y = top + (H - top) * t;
    const half = 6 + width(t) * 0.08;
    return `M${pt([x - half, y])} L${pt([x + half, y])}`;
  }).join(" ");
  return {
    back,
    far: mountains(random, 215, 95, 190),
    mid: treeline(
      seeded(211),
      curve(
        range(-40, W + 40, 60).map(
          (x): Point => [x, valley(x) - random() * 14],
        ),
      ),
      0.9,
    ),
    ground: ground(groundY),
    water: polygon([...bank(-1), ...bank(1).reverse()]),
    glints,
    trees: forest(random, groundY, {
      gap: [8, 22],
      broadleaf: 0.45,
      skip: (x, g) => {
        const t = (g - top) / (H - top);
        return Math.abs(x - centre(t)) < width(t) / 2 + 14;
      },
    }),
  };
})();

/* Lake: still water reflecting the mountains, with wooded shores. */
const LAKE_SHORE = 290;
const lakeScene = (() => {
  const random = seeded(23);
  const reach = 380;
  const leftY = (x: number) => LAKE_SHORE + 28 + (x / reach) ** 2 * 110;
  const rightY = (x: number) => LAKE_SHORE + 28 + ((W - x) / reach) ** 2 * 110;
  const onShore = (_: number, g: number) => g > H - 18;
  const left = forest(random, leftY, {
    to: reach,
    gap: [8, 20],
    broadleaf: 0.4,
    skip: onShore,
  });
  const right = forest(random, rightY, {
    from: W - reach,
    gap: [8, 20],
    broadleaf: 0.4,
    skip: onShore,
  });
  const glints = Array.from({ length: 9 }, () => {
    const x = 380 + random() * 680;
    const y = LAKE_SHORE + 14 + random() * (H - LAKE_SHORE - 20);
    const half = 8 + random() * 26;
    return `M${pt([x - half, y])} L${pt([x + half, y])}`;
  }).join(" ");
  return {
    back: mountains(seeded(123), 200, 150, 115),
    far: mountains(random, 240, 150, 170),
    mid: treeline(
      seeded(223),
      curve(ridgePoints(random, LAKE_SHORE + 2, 22, 110)),
      0.8,
    ),
    shores: `${ground(leftY, 0, reach)} ${ground(rightY, W - reach, W)}`,
    glints,
    trees: {
      pines: left.pines + right.pines,
      leaves: left.leaves + right.leaves,
      shade: left.shade + right.shade,
    },
  };
})();

/* Rolling hills: soft green hills dotted with trees. */
const hillScene = (() => {
  const random = seeded(31);
  const midY = (x: number) =>
    285 + Math.sin(x / 210 + 1) * 22 + Math.sin(x / 90) * 5;
  const groundY = (x: number) =>
    342 + Math.sin(x / 260) * 20 + Math.sin(x / 97 + 2) * 6;
  const far = forest(random, midY, {
    gap: [30, 120],
    broadleaf: 0.7,
    scale: 0.55,
  });
  const near = forest(random, groundY, { gap: [40, 170], broadleaf: 0.75 });
  return {
    back: ridge(seeded(131), 212, 40, 200),
    far: treeline(seeded(231), curve(ridgePoints(random, 238, 45, 260)), 0.45),
    mid: smoothHill(range(-60, W + 60, 60).map((x): Point => [x, midY(x)])),
    ground: ground(groundY),
    // The small trees on the far hill, and the nearer ones.
    midTrees: far,
    trees: near,
  };
})();

/* The sky and the falling things. Their own seed keeps the landscapes
   unchanged if these change. */
const random = seeded(99);

const stars = Array.from({ length: 40 }, () => ({
  left: `${(random() * 100).toFixed(1)}%`,
  top: `${(random() * 45).toFixed(1)}%`,
  opacity: (0.15 + random() * 0.35).toFixed(2),
}));

const clouds = Array.from({ length: 5 }, (_, i) => ({
  left: `${round(i * 20 + random() * 12 - 10)}%`,
  top: `${round(6 + random() * 30)}%`,
  width: `${round(220 + random() * 220)}px`,
  height: `${round(50 + random() * 40)}px`,
  delay: `${(-random() * 70).toFixed(1)}s`,
}));

const fireflies = Array.from({ length: 14 }, () => ({
  left: `${round(4 + random() * 92)}%`,
  bottom: `${round(4 + random() * 14)}vh`,
  delay: `${(-random() * 8).toFixed(1)}s`,
  duration: `${(6 + random() * 6).toFixed(1)}s`,
}));

/** Petals, leaves or snowflakes falling from above the top of the screen. */
const falling = (count: number, speed: [number, number], spin: boolean) =>
  Array.from({ length: count }, () => {
    const duration = speed[0] + random() * (speed[1] - speed[0]);
    return [
      `left:${(random() * 100).toFixed(1)}%`,
      `animation-duration:${duration.toFixed(1)}s`,
      `animation-delay:${(-random() * duration).toFixed(1)}s`,
      `--drift:${round((random() - 0.5) * 240)}px`,
      `--spin:${spin ? round(240 + random() * 600) : 0}deg`,
      `--size:${(0.6 + random() * 0.8).toFixed(2)}`,
    ].join(";");
  });

const petals = falling(18, [14, 24], true);
const leaves = falling(16, [12, 20], true);
const snow = falling(46, [10, 22], false);

const viewBox = `0 0 ${W} ${H}`;
const fit = "xMidYMax slice";

/** Fog pooling at the foot of a layer, from clear at `top` to thick at `foot`. */
const fog = (top: number, foot: number) => ({
  x: -100,
  y: top,
  width: W + 200,
  height: foot - top,
  fill: "url(#fog)",
  class: "fog",
});

/** Below a layer's foot the fog stays thick, so it never stops at a hard
    line where the next layer does not yet cover it. */
const fogBelow = (foot: number) => ({
  x: -100,
  y: foot,
  width: W + 200,
  height: H - foot + 10,
  class: "fog-below",
});
---

<div class="backdrop" aria-hidden="true" transition:persist="backdrop">
  <div class="sky-day"></div>
  <div class="stars">
    {
      stars.map((star) => (
        <span
          style={`left:${star.left};top:${star.top};opacity:${star.opacity}`}
        />
      ))
    }
  </div>
  <div class="moon"></div>
  <div class="sun"></div>
  <div class="clouds">
    {
      clouds.map((c) => (
        <span
          style={`left:${c.left};top:${c.top};width:${c.width};height:${c.height};animation-delay:${c.delay}`}
        />
      ))
    }
  </div>
  <div class="mist mist-a"></div>

  <!-- Shared by the landscapes: fog that thickens downwards, and the
       foreground darkening towards the bottom edge. The colours come from
       the stylesheet. -->
  <svg class="landscape-defs" width="0" height="0">
    <defs>
      <linearGradient id="fog" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="fog-stop" stop-opacity="0"></stop>
        <stop offset="1" class="fog-stop fog-thick"></stop>
      </linearGradient>
      <linearGradient id="near-shade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="near-stop" stop-opacity="0"></stop>
        <stop offset="1" class="near-stop near-dark"></stop>
      </linearGradient>
    </defs>
  </svg>

  <!--
    Each landscape is in depth layers, from the back: the faint far range,
    the main range, the middle hills, and the near ground and trees. Fog
    pools at the foot of each layer, so every step back fades towards the
    sky.
  -->
  <svg
    class="landscape landscape-mountains"
    viewBox={viewBox}
    preserveAspectRatio={fit}
  >
    <g class="layer layer-back">
      <path class="back" d={mountainScene.back.shape}></path>
      <path class="snowcap" d={mountainScene.back.caps}></path>
      <path class="shade" d={mountainScene.back.shade}></path>
      <path class="gully" d={mountainScene.back.gullies}></path>
      <rect {...fog(110, 215)}></rect>
      <rect {...fogBelow(215)}></rect>
    </g>
    <g class="layer layer-far">
      <path class="far" d={mountainScene.far.shape}></path>
      <path class="snowcap" d={mountainScene.far.caps}></path>
      <path class="shade" d={mountainScene.far.shade}></path>
      <path class="gully" d={mountainScene.far.gullies}></path>
      <rect {...fog(150, 250)}></rect>
      <rect {...fogBelow(250)}></rect>
    </g>
    <g class="layer layer-mid">
      <path class="mid" d={mountainScene.mid}></path>
      <rect {...fog(250, 330)}></rect>
      <rect {...fogBelow(330)}></rect>
    </g>
    <g class="layer layer-near">
      <path class="ground" d={mountainScene.ground}></path>
      <!-- A row of smaller trees further back, paler with distance. -->
      <g class="distant">
        <path class="leaf" d={mountainScene.backTrees.leaves}></path>
        <path class="pine" d={mountainScene.backTrees.pines}></path>
        <path class="tree-shade" d={mountainScene.backTrees.shade}></path>
      </g>
      <path class="leaf" d={mountainScene.trees.leaves}></path>
      <path class="pine" d={mountainScene.trees.pines}></path>
      <path class="tree-shade" d={mountainScene.trees.shade}></path>
      <rect class="near-shade" x="-100" y="330" width={W + 200} height="70"
      ></rect>
    </g>
  </svg>

  <svg
    class="landscape landscape-river"
    viewBox={viewBox}
    preserveAspectRatio={fit}
  >
    <g class="layer layer-back">
      <path class="back" d={riverScene.back.shape}></path>
      <path class="snowcap" d={riverScene.back.caps}></path>
      <path class="shade" d={riverScene.back.shade}></path>
      <path class="gully" d={riverScene.back.gullies}></path>
      <rect {...fog(130, 205)}></rect>
      <rect {...fogBelow(205)}></rect>
    </g>
    <g class="layer layer-far">
      <path class="far" d={riverScene.far.shape}></path>
      <path class="snowcap" d={riverScene.far.caps}></path>
      <path class="shade" d={riverScene.far.shade}></path>
      <path class="gully" d={riverScene.far.gullies}></path>
      <rect {...fog(160, 235)}></rect>
      <rect {...fogBelow(235)}></rect>
    </g>
    <g class="layer layer-mid">
      <path class="mid" d={riverScene.mid}></path>
      <rect {...fog(240, 300)}></rect>
      <rect {...fogBelow(300)}></rect>
    </g>
    <g class="layer layer-near">
      <path class="ground" d={riverScene.ground}></path>
      <path class="water" d={riverScene.water}></path>
      <path class="glint" d={riverScene.glints}></path>
      <path class="leaf" d={riverScene.trees.leaves}></path>
      <path class="pine" d={riverScene.trees.pines}></path>
      <path class="tree-shade" d={riverScene.trees.shade}></path>
      <rect class="near-shade" x="-100" y="330" width={W + 200} height="70"
      ></rect>
    </g>
  </svg>

  <svg
    class="landscape landscape-lake"
    viewBox={viewBox}
    preserveAspectRatio={fit}
  >
    <clipPath id="lake-water">
      <rect x="-100" y={LAKE_SHORE} width={W + 200} height={H - LAKE_SHORE}
      ></rect>
    </clipPath>
    <g class="layer layer-back">
      <path class="back" d={lakeScene.back.shape}></path>
      <path class="snowcap" d={lakeScene.back.caps}></path>
      <path class="shade" d={lakeScene.back.shade}></path>
      <path class="gully" d={lakeScene.back.gullies}></path>
      <rect {...fog(130, 225)}></rect>
      <rect {...fogBelow(225)}></rect>
    </g>
    <g class="layer layer-far">
      <path class="far" d={lakeScene.far.shape}></path>
      <path class="snowcap" d={lakeScene.far.caps}></path>
      <path class="shade" d={lakeScene.far.shade}></path>
      <path class="gully" d={lakeScene.far.gullies}></path>
      <rect {...fog(190, 270)}></rect>
      <rect {...fogBelow(270)}></rect>
    </g>
    <g class="layer layer-mid">
      <path class="mid" d={lakeScene.mid}></path>
    </g>
    <rect
      class="water"
      x="-100"
      y={LAKE_SHORE}
      width={W + 200}
      height={H - LAKE_SHORE}></rect>
    <!-- The mountains mirrored in the still water; each copy shifts with
         its layer, so the reflection stays under what it reflects. -->
    <g class="reflection" clip-path="url(#lake-water)">
      <g transform={`translate(0 ${2 * LAKE_SHORE}) scale(1 -1)`}>
        <g class="layer layer-far">
          <path class="far" d={lakeScene.far.shape}></path>
          <path class="snowcap" d={lakeScene.far.caps}></path>
          <path class="shade" d={lakeScene.far.shade}></path>
          <path class="gully" d={lakeScene.far.gullies}></path>
        </g>
        <g class="layer layer-mid">
          <path class="mid" d={lakeScene.mid}></path>
        </g>
      </g>
    </g>
    <g class="layer layer-near">
      <path class="glint" d={lakeScene.glints}></path>
      <path class="ground" d={lakeScene.shores}></path>
      <path class="leaf" d={lakeScene.trees.leaves}></path>
      <path class="pine" d={lakeScene.trees.pines}></path>
      <path class="tree-shade" d={lakeScene.trees.shade}></path>
    </g>
  </svg>

  <svg
    class="landscape landscape-hills"
    viewBox={viewBox}
    preserveAspectRatio={fit}
  >
    <g class="layer layer-back">
      <path class="back" d={hillScene.back}></path>
      <rect {...fog(190, 240)}></rect>
      <rect {...fogBelow(240)}></rect>
    </g>
    <g class="layer layer-far">
      <path class="far" d={hillScene.far}></path>
      <rect {...fog(215, 285)}></rect>
      <rect {...fogBelow(285)}></rect>
    </g>
    <g class="layer layer-mid">
      <path class="mid" d={hillScene.mid}></path>
      <path class="leaf" d={hillScene.midTrees.leaves}></path>
      <path class="pine" d={hillScene.midTrees.pines}></path>
      <path class="tree-shade" d={hillScene.midTrees.shade}></path>
      <rect {...fog(315, 350)}></rect>
      <rect {...fogBelow(350)}></rect>
    </g>
    <g class="layer layer-near">
      <path class="ground" d={hillScene.ground}></path>
      <path class="leaf" d={hillScene.trees.leaves}></path>
      <path class="pine" d={hillScene.trees.pines}></path>
      <path class="tree-shade" d={hillScene.trees.shade}></path>
      <rect class="near-shade" x="-100" y="340" width={W + 200} height="60"
      ></rect>
    </g>
  </svg>

  <div class="mist mist-b"></div>
</div>

<!--
  The weather: fireflies and falling petals, leaves or snow. A layer of its
  own above the page, so they drift in front of the terminal as well as the
  landscape. It never takes clicks.
-->
<div class="weather" aria-hidden="true" transition:persist="weather">
  <div class="fireflies">
    {
      fireflies.map((f) => (
        <span
          style={`left:${f.left};bottom:${f.bottom};animation-delay:${f.delay};animation-duration:${f.duration}`}
        />
      ))
    }
  </div>
  <div class="falling petals">
    {petals.map((style) => <span style={style} />)}
  </div>
  <div class="falling leaves">
    {leaves.map((style) => <span style={style} />)}
  </div>
  <div class="falling snow">{snow.map((style) => <span style={style} />)}</div>
</div>
