---
import { navItems, siteName, type NavKey } from "../site";

interface Props {
  current?: NavKey;
}

const { current } = Astro.props;
---

<header class="site-header">
  <a href="/" class="brand" aria-label={`${siteName}, home`}>
    <img
      src="/assets/tokyo_pfp.png"
      alt=""
      width="28"
      height="28"
      class="brand-avatar"
    />
    <span>{siteName}</span>
  </a>

  <div class="nav-right">
    <nav class="nav-links" aria-label="Main">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { "is-current": item.key === current }]}
            aria-current={item.key === current ? "page" : undefined}
          >
            {/* Its own element so it can slide between links on navigation. */}
            {item.key === current && <span class="nav-mark" />}
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Season and day/night buttons, wired up in scripts/scene.ts. -->
    <div class="header-controls">
      <!-- Shows the current season; a click moves to the next one. -->
      <button
        type="button"
        class="icon-button season-toggle"
        data-season-toggle
        aria-label="Change season"
        title="Change season"
      >
        <svg
          class="icon-spring"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <circle cx="12" cy="7.2" r="3"></circle>
          <circle cx="16.8" cy="12" r="3"></circle>
          <circle cx="12" cy="16.8" r="3"></circle>
          <circle cx="7.2" cy="12" r="3"></circle>
          <circle cx="12" cy="12" r="1.4"></circle>
        </svg>
        <svg
          class="icon-summer"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M12 15c-3.8 0-6.5-2.4-6.5-5.6S8.4 3.5 12 3.5s6.5 2.5 6.5 5.9S15.8 15 12 15z"
          ></path>
          <path d="M12 21v-6M9.5 21h5"></path>
        </svg>
        <svg
          class="icon-autumn"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 19C5 10.5 10 5 19.5 4.5 19 14 13.5 19 5 19z"></path>
          <path d="M4 20l9.5-9.5"></path>
        </svg>
        <svg
          class="icon-winter"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9M9.5 4.5 12 6l2.5-1.5M9.5 19.5 12 18l2.5 1.5"
          ></path>
        </svg>
      </button>

      <!-- Shows the theme a click switches to. -->
      <button
        type="button"
        class="icon-button theme-toggle"
        data-theme-toggle
        aria-label="Switch to day"
        title="Switch to day"
      >
        <svg
          class="icon-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4.2"></circle>
          <path
            d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.55 1.55M17.15 17.15l1.55 1.55M5.3 18.7l1.55-1.55M17.15 6.85l1.55-1.55"
          ></path>
        </svg>
        <svg
          class="icon-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
