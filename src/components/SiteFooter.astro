---
import { contact, siteName } from "../site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <span>
      &copy; {year}
      {siteName} &middot; Built with
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer"
        >Astro</a
      >
      and
      <a
        href="https://claude.com/claude-code"
        target="_blank"
        rel="noopener noreferrer">Claude Code</a
      >
    </span>
    <div class="footer-links">
      <a href={`mailto:${contact.email}`}>Email</a>
      <a href={contact.githubUrl} target="_blank" rel="noopener noreferrer"
        >GitHub</a
      >
      <a href={contact.resume} target="_blank">Resume</a>
    </div>
  </div>
</footer>
