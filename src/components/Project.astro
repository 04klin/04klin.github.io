---
// Project.astro
const { title, desc, links = [], tech } = Astro.props;
---

<div class="single-item">
  <h3>{title}</h3>

  <div class="project-desc project-desc-list w-richtext">
    <ul role="list">
      {desc.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  {
    links.length > 0 && (
      <>
        <br />
        <div
          class="button-group"
          style="display: flex; gap: 10px; flex-wrap: wrap;"
        >
          {links.map((link) => (
            <a href={link.url} class="button" target="_blank">
              {link.text}
            </a>
          ))}
        </div>
      </>
    )
  }

  <div class="mini-label-white">Technologies &amp; tools</div>
  <div class="chips-container">
    {tech.map((techItem) => <div class="single-chip">{techItem}</div>)}
  </div>
</div>
