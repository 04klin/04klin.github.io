---
import type { CollectionEntry } from "astro:content";

type Props = CollectionEntry<"projects">["data"] & {
  /** Anchor for links from the home page (`/projects#<id>`). */
  id: string;
};

const { id, title, context, status, about, links, tech } = Astro.props;
---

<article class="project" id={id}>
  <div class="project-aside">
    <h2>{title}</h2>
    {context && <p class="project-context">{context}</p>}
    {status && <p class="status">{status}</p>}
  </div>

  <div class="project-body">
    {about && <p class="project-about">{about}</p>}

    <p class="tech">{tech.join(", ")}</p>

    {
      links.length > 0 && (
        <p class="link-row">
          {links.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.text}
            </a>
          ))}
        </p>
      )
    }
  </div>
</article>
