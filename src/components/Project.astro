---
import type { CollectionEntry } from "astro:content";

type Props = CollectionEntry<"projects">["data"] & {
  /** Anchor for links from the home page (`/projects#<id>`). */
  id: string;
};

const { id, title, desc, links, tech } = Astro.props;
---

<article class="project" id={id} data-reveal>
  <div class="project-aside">
    <div class="project-number"></div>
    <h2>{title}</h2>
  </div>

  <div class="project-body">
    <ul class="project-desc">
      {desc.map((item) => <li>{item}</li>)}
    </ul>

    <div class="chips">
      {tech.map((techItem) => <span class="chip">{techItem}</span>)}
    </div>

    {
      links.length > 0 && (
        <div class="button-row">
          {links.map((link) => (
            <a
              href={link.url}
              class="button"
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.text}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
