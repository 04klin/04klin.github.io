---
import { ClientRouter } from "astro:transitions";
import Backdrop from "../components/Backdrop.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteName, type NavKey } from "../site";

interface Props {
  /** Which top bar link to highlight. Omit on pages outside the nav. */
  current?: NavKey;
  /**
   * Page heading. When set, the page gets an <h1> and a
   * "<heading> | <site name>" title. Omit it for the home page.
   */
  heading?: string;
  /** One line under the heading. */
  lead?: string;
  /** Summary for search results and link previews. */
  description?: string;
  /**
   * Scrolling down passes the time of day in the backdrop (morning to golden
   * hour by day, dusk to dawn by night). The home page only.
   */
  walk?: boolean;
}

const {
  current,
  heading,
  lead,
  description = "Kevin Lin's projects and photography.",
  walk = false,
} = Astro.props;
const title = heading ? `${heading} | ${siteName}` : siteName;

// Link previews (Discord, iMessage, LinkedIn, ...) need absolute URLs.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const previewImage = new URL("/assets/og-image.png", Astro.site).href;
---

<!doctype html>
<html lang="en" data-walk={walk ? "" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <!-- Link previews. Discord also uses theme-color for the embed's side bar. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Kevin Lin: projects and photography"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="theme-color" content="#a3d977" />
    <!--
      Sets the background scene (day or night, season, landscape) before the
      first paint so the page never flashes the wrong one. A view transition
      swap replaces the <html> attributes, so they are set again after each
      swap. See scripts/scene.ts.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        // Northern hemisphere seasons, indexed by month.
        const byMonth = [
          "winter",
          "winter",
          "spring",
          "spring",
          "spring",
          "summer",
          "summer",
          "summer",
          "autumn",
          "autumn",
          "autumn",
          "winter",
        ];
        const scenes = ["mountains", "river", "lake", "hills"];
        const read = (storage, key) => {
          try {
            return storage.getItem(key);
          } catch {
            return null;
          }
        };
        // A new landscape on every page load (including reloads). It is kept
        // in memory, so it stays the same while the visitor clicks between
        // pages, which swap the page without reloading it.
        window.__scene ??= scenes[Math.floor(Math.random() * scenes.length)];

        const apply = () => {
          const now = new Date();

          // The visitor's own clock: day from 7am to 7pm, unless they chose
          // with the button during this visit.
          const theme = read(sessionStorage, "theme");
          const hour = now.getHours();
          root.dataset.theme = ["day", "night"].includes(theme)
            ? theme
            : hour >= 7 && hour < 19
              ? "day"
              : "night";

          const season = read(sessionStorage, "season");
          root.dataset.season = byMonth.includes(season)
            ? season
            : byMonth[now.getMonth()];

          root.dataset.scene = window.__scene;
        };
        apply();
        if (!window.__sceneOnSwap) {
          window.__sceneOnSwap = true;
          document.addEventListener("astro:after-swap", apply);
        }
      })();
    </script>
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <link href="/assets/styles.css" rel="stylesheet" type="text/css" />
    <link
      href="/assets/tokyo_pfp.png"
      rel="shortcut icon"
      type="image/x-icon"
    />
    <link href="/assets/tokyo_pfp.png" rel="apple-touch-icon" />
    <noscript>
      <style>
        /* The season and day/night buttons need JS. */
        .header-controls {
          display: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <!-- Kept across navigations so its animations do not restart. -->
    <Backdrop />

    <SiteHeader current={current} />

    <main class="page">
      {
        heading && (
          <header class="page-header">
            <h1>{heading}</h1>
            {lead && <p class="lead">{lead}</p>}
          </header>
        )
      }
      <slot />
    </main>

    <SiteFooter />

    <script>
      import { setupSceneControls, setupWalkFallback } from "../scripts/scene";

      setupSceneControls();
      setupWalkFallback();
    </script>


  </body>
</html>
