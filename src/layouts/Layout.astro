---
import { ClientRouter } from "astro:transitions";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteName, type NavKey } from "../site";

interface Props {
  /** Which top bar link to highlight. Omit on pages outside the nav. */
  current?: NavKey;
  /**
   * Page heading. When set, the page gets an <h1> and a
   * "<heading> | <site name>" title. Omit it for the home page.
   */
  heading?: string;
  /** One line under the heading. */
  lead?: string;
  /** Summary for search results and link previews. */
  description?: string;
}

const {
  current,
  heading,
  lead,
  description = "Kevin Lin's projects and photography.",
} = Astro.props;
const title = heading ? `${heading} | ${siteName}` : siteName;

// Link previews (Discord, iMessage, LinkedIn, ...) need absolute URLs.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const previewImage = new URL("/assets/og-image.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <!-- Link previews. Discord also uses theme-color for the embed's side bar. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Kevin Lin: projects and photography"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="theme-color" content="#a3d977" />
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <link href="/assets/styles.css" rel="stylesheet" type="text/css" />
    <link
      href="/assets/tokyo_pfp.png"
      rel="shortcut icon"
      type="image/x-icon"
    />
    <link href="/assets/tokyo_pfp.png" rel="apple-touch-icon" />
    <!-- Reveal animations need JS; without it, show everything. -->
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <!-- Kept across navigations so the aurora does not restart. -->
    <div class="backdrop" aria-hidden="true" transition:persist="backdrop">
      <div class="aurora aurora-a"></div>
      <div class="aurora aurora-b"></div>
      <div class="backdrop-grid"></div>
    </div>
    <div class="scroll-progress" aria-hidden="true"></div>

    <SiteHeader current={current} />

    <main class="page">
      {
        heading && (
          <header class="page-header">
            <h1 data-reveal>{heading}</h1>
            {lead && (
              <p class="lead" data-reveal>
                {lead}
              </p>
            )}
          </header>
        )
      }
      <slot />
    </main>

    <SiteFooter />

    <script>
      import {
        setupCardGlow,
        setupReveal,
        setupSpotlight,
      } from "../scripts/motion";

      let cleanups: (() => void)[] = [];
      const cleanup = () => {
        cleanups.forEach((fn) => fn());
        cleanups = [];
      };

      document.addEventListener("astro:page-load", () => {
        cleanup();
        cleanups = [setupReveal(), setupSpotlight(), setupCardGlow()];
      });
      document.addEventListener("astro:before-swap", cleanup);
    </script>


  </body>
</html>
